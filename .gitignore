# 缓存与产物
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# 数据库（体积大且可重建，不入库）
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
server/data/*.sqlite3
data/

# 采集中间态
server/data/raw/
server/data/coupons.json
*.jsonl
*.log

# 临时文件（禁止落 C 盘，统一放项目 temp/）
temp/
*.tmp

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 本地密钥与部署脚本（含服务器信息）
deploy.local.sh
*.pem

# 打包产物（用 scripts/package_extension.py 生成）
dist/

# 本地工作记录（含服务器信息，不入库）
.workbuddy/
# 图标由 scripts/make_icons.py 生成，不入库
extension/icons/*.png
