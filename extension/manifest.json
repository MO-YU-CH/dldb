{
  "manifest_version": 3,
  "name": "DLsite Coupon Plus",
  "version": "2.1.1",
  "description": "DLsite 作品ページにクーポン適用後の最安値と価格推移を表示し、多部購買の試算も行います。UI は DLsite の表示言語に追従します。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://dlsite.momo-yu.com/*",
    "https://www.dlsite.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dlsite.com/*/work/=/product_id/*"
      ],
      "js": [
        "lib/i18n.js",
        "lib/coupon.js",
        "lib/history.js",
        "content.js",
        "lib/lowpos.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.dlsite.com/*/cart",
        "https://www.dlsite.com/*/cart/*"
      ],
      "js": [
        "lib/i18n.js",
        "lib/coupon.js",
        "lib/history.js",
        "lib/cart.js",
        "cart-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DLsite Coupon Plus"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
