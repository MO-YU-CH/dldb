[Unit]
Description=Recompute today's coupon price for every work (no crawling)
After=dldb.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dldb/server
Environment=DLDB_PATH=/home/ubuntu/dldb/server/data/dlsite.db
ExecStart=/home/ubuntu/dldb/server/.venv/bin/python coupon_daily.py
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/dldb/server/data
