[Unit]
Description=DLsite Coupon Plus SQLite snapshot backup
After=dldb.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dldb/server
Environment=DLDB_PATH=/home/ubuntu/dldb/server/data/dlsite.db
ExecStart=/home/ubuntu/dldb/server/.venv/bin/python backup.py --keep 7
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/dldb/server/data
